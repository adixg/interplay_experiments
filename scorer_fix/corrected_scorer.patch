+# Characters an assignment's right-hand side may contain besides standalone letters.
+MATH_CHARS = set("0123456789+-*/()=. \t")
+
+
+def math_prefix(expr: str) -> str:
+    """Cut an expression at the first character that is not mathematical.
+
+    A letter only counts as a variable when no other letter stands next to it,
+    so the prose after an equation ("w = 40, so we have ...") is not read as inputs.
+    """
+    end = 0
+    for i, ch in enumerate(expr):
+        if ch.isalpha():
+            if (i > 0 and expr[i - 1].isalpha()) or (i + 1 < len(expr) and expr[i + 1].isalpha()):
+                break
+        elif ch not in MATH_CHARS:
+            break
+        end = i + 1
+    return expr[:end].strip()
 
 
